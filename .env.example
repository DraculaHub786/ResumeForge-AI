# =============================================================================
# ResumeForge AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Development: SQLite (file-based, zero-config)
# Production: PostgreSQL (recommended)
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=file:./dev.db

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5000

# Extra front-end origins that may talk to the auth endpoints. Better Auth
# rejects any request from an origin it does not know, so every URL the app is
# served from has to be listed here (comma-separated).
# TRUSTED_ORIGINS=http://localhost:3000

# OAuth Providers (optional - enable as needed)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI / OpenRouter
# -----------------------------------------------------------------------------
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model for AI enhancement (fallback if not specified in request)
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Budget for the general API, per signed-in account (or per IP when signed
# out). A monitor polling /api/v1/health is never counted.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Tighter budget for the credential endpoints, per account + IP pair.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Number of reverse-proxy hops to trust for the client IP. Use 1 when a
# single proxy (nginx, Fly, Railway, Cloudflare) sits in front of the app.
# `true` is not supported — it would let a client spoof X-Forwarded-For.
TRUST_PROXY=0

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# -----------------------------------------------------------------------------
# Export (Optional)
# -----------------------------------------------------------------------------
# Path to pdflatex binary for server-side LaTeX compilation (optional)
# LATEX_BINARY=pdflatex

# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# LOG_LEVEL=info