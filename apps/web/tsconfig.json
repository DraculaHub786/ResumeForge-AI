{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@resume-builder/types": ["../../packages/types/src/index.ts"],
      "@resume-builder/types/*": ["../../packages/types/src/*"],
      "@resume-builder/ui": ["../../packages/ui/src/index.ts"],
      "@resume-builder/ui/*": ["../../packages/ui/src/*"],
      "@resume-builder/ai": ["../../packages/ai/src/index.ts"],
      "@resume-builder/ai/*": ["../../packages/ai/src/*"],
      "@resume-builder/pdf": ["../../packages/pdf/src/index.ts"],
      "@resume-builder/pdf/browser": ["../../packages/pdf/src/browser.ts"],
      "@resume-builder/pdf/server": ["../../packages/pdf/src/server.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}